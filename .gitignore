.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# runtime data — never commit
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/raw/
data/cache/
data/tmp/
data/backups/
data/*.npz
data/*.joblib
data/dashboard.html
data/live_snapshot.json
# real, regenerable via `fpl sync-crests` - never worth committing 20
# binary PNGs that a fresh checkout can re-fetch in seconds
data/crests/
logs/*.log
logs/*.log.*
*.cache/
.tmp/

# secrets
.env
*.env.local

# OS
.DS_Store
Thumbs.db
